<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="accounting.controller.IncomeStatementController">
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <Label text="قائمة الدخل" styleClass="title">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="filter-pane">
                <Label text="من تاريخ:" />
                <DatePicker fx:id="fromDatePicker" />
                <Label text="إلى تاريخ:" />
                <DatePicker fx:id="toDatePicker" />
                <Button fx:id="viewButton" mnemonicParsing="false" text="عرض" />
            </HBox>
            <Separator prefWidth="200.0" />
            <GridPane hgap="10.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                </columnConstraints>
                <VBox fx:id="revenueVBox" spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="الإيرادات" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" />
                    </VBox>
                <VBox fx:id="expenseVBox" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <Label text="المصروفات" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" />
                     </VBox>
            </GridPane>
            <Separator prefWidth="200.0" />
            <GridPane hgap="10.0">
                 <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                </columnConstraints>
                <Label text="صافي الربح / الخسارة" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="0" />
                <Label fx:id="netIncomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="0.00" GridPane.columnIndex="1" />
            </GridPane>
        </VBox>
    </children>
</AnchorPane>