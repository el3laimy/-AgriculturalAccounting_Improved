<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="accounting.controller.GeneralLedgerController">
   <children>
      <BorderPane layoutX="268.0" layoutY="168.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <VBox spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="دفتر الأستاذ العام" styleClass="title">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="filter-pane">
                     <children>
                        <Label text="من تاريخ:" />
                        <DatePicker fx:id="fromDatePicker" />
                        <Label text="إلى تاريخ:" />
                        <DatePicker fx:id="toDatePicker" />
                        <Button fx:id="filterButton" mnemonicParsing="false" text="تطبيق" />
                        <Button fx:id="clearButton" mnemonicParsing="false" styleClass="secondary" text="مسح الفلتر" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </top>
         <center>
            <TableView fx:id="ledgerTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="dateColumn" prefWidth="100.0" text="التاريخ" />
                <TableColumn fx:id="refColumn" prefWidth="120.0" text="مرجع العملية" />
                <TableColumn fx:id="descriptionColumn" prefWidth="350.0" text="البيان" />
                  <TableColumn fx:id="debitColumn" prefWidth="100.0" text="مدين" />
                  <TableColumn fx:id="creditColumn" prefWidth="100.0" text="دائن" />
              </columns>
               <BorderPane.margin>
                  <Insets left="10.0" right="10.0" />
               </BorderPane.margin>
            </TableView>
         </center>
         <bottom>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="filter-pane" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="totalDebitLabel" text="إجمالي المدين: 0.00" />
                  <Label fx:id="totalCreditLabel" text="إجمالي الدائن: 0.00" />
                  <Label fx:id="balanceLabel" text="الحالة: متزن" style="-fx-font-weight: bold;" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>