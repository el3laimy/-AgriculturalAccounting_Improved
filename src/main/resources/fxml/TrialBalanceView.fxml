<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="accounting.controller.TrialBalanceController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <VBox spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="ميزان المراجعة" styleClass="title">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="filter-pane">
                     <children>
                        <Label text="حتى تاريخ:" />
                        <DatePicker fx:id="toDatePicker" />
                        <Button fx:id="viewButton" mnemonicParsing="false" text="عرض" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </top>
         <center>
            <TableView fx:id="trialBalanceTable" prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="accountIdColumn" prefWidth="100.0" text="رقم الحساب" />
                <TableColumn fx:id="accountNameColumn" prefWidth="250.0" text="اسم الحساب" />
                <TableColumn fx:id="debitColumn" prefWidth="150.0" text="إجمالي مدين" />
                <TableColumn fx:id="creditColumn" prefWidth="150.0" text="إجمالي دائن" />
              </columns>
            </TableView>
         </center>
         <bottom>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="filter-pane">
               <children>
                  <Label fx:id="totalDebitLabel" style="-fx-font-weight: bold;" text="الإجمالي المدين: 0.00" />
                  <Label fx:id="totalCreditLabel" style="-fx-font-weight: bold;" text="الإجمالي الدائن: 0.00" />
                  <Label fx:id="statusLabel" style="-fx-font-weight: bold;" text="الحالة:" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>