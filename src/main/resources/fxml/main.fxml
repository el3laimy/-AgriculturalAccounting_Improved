<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="mainBorderPane" prefHeight="800.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="accounting.controller.MainController">
   <right>
      <VBox fx:id="sideNavigationBar" alignment="TOP_CENTER" prefWidth="220.0" styleClass="side-navigation-bar">
         <children>
            <Label style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" text="نظام المحاسبة">
               <VBox.margin>
                  <Insets bottom="20.0" top="10.0" />
               </VBox.margin>
            </Label>
            <Button fx:id="dashboardBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showDashboard" text="لوحة التحكم">
               <graphic><FontIcon iconLiteral="fa-home" /></graphic>
            </Button>
            <Button fx:id="purchasesBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showPurchases" text="المشتريات">
               <graphic><FontIcon iconLiteral="fa-shopping-cart" /></graphic>
            </Button>
            <Button fx:id="salesBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showSales" text="المبيعات">
               <graphic><FontIcon iconLiteral="fa-dollar" /></graphic>
            </Button>
            <Button fx:id="inventoryBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showInventory" text="المخزون">
               <graphic><FontIcon iconLiteral="fa-archive" /></graphic>
            </Button>
            <Button fx:id="expensesBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showExpenses" text="المصروفات">
               <graphic><FontIcon iconLiteral="fa-credit-card" /></graphic>
            </Button>
            <Button fx:id="contactsBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#handleManageContacts" text="جهات التعامل">
               <graphic><FontIcon iconLiteral="fa-users" /></graphic>
            </Button>
            <Label text="التقارير" style="-fx-text-fill: #95a5a6; -fx-padding: 15 0 5 0;" />
            <Button fx:id="generalLedgerBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#handleViewGeneralLedger" text="دفتر الأستاذ العام">
               <graphic><FontIcon iconLiteral="fa-book" /></graphic>
            </Button>
            <Button fx:id="reportsBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showReportsDashboard" text="التقارير المتقدمة">
               <graphic><FontIcon iconLiteral="fa-line-chart" /></graphic>
            </Button>

            <Button fx:id="alertsBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#handleShowAlerts" text="التنبيهات">
                <graphic><FontIcon iconLiteral="fa-bell" /></graphic>
            </Button>

            <Label text="الإدارة والتقارير" style="-fx-text-fill: #95a5a6; -fx-padding: 15 0 5 0;" />
            <javafx.scene.control.MenuButton fx:id="financialReportsMenuBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" text="التقارير المالية" styleClass="navigation-menu-button">
              <graphic><FontIcon iconLiteral="fa-file-text-o" /></graphic>
              <items>
                <javafx.scene.control.MenuItem fx:id="trialBalanceMenuItem" mnemonicParsing="false" onAction="#handleShowTrialBalance" text="ميزان المراجعة" />
                <javafx.scene.control.MenuItem fx:id="incomeStatementMenuItem" mnemonicParsing="false" onAction="#handleShowIncomeStatement" text="قائمة الدخل" />
                <javafx.scene.control.MenuItem fx:id="balanceSheetMenuItem" mnemonicParsing="false" onAction="#handleShowBalanceSheet" text="الميزانية العمومية" />
              </items>
            </javafx.scene.control.MenuButton>

            <javafx.scene.control.MenuButton fx:id="settingsMenuBtn" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" text="الإعدادات" styleClass="navigation-menu-button">
              <graphic><FontIcon iconLiteral="fa-cogs" /></graphic>
              <items>
                <javafx.scene.control.MenuItem fx:id="cropManagementMenuItem" mnemonicParsing="false" onAction="#handleShowCropManagement" text="إدارة المحاصيل" />
                <javafx.scene.control.MenuItem fx:id="financialAccountManagementMenuItem" mnemonicParsing="false" onAction="#handleShowFinancialAccountManagement" text="إدارة الحسابات المالية" />
              </items>
            </javafx.scene.control.MenuButton>

            <VBox VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </right>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="header-bar">
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
               <children>
                  <Label fx:id="viewTitleLabel" styleClass="header-title" text="لوحة التحكم" />
                  <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="dateTimeLabel" style="-fx-text-fill: -fx-text-secondary;" text="DATE_TIME" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" style="-fx-background-color: -fx-base; -fx-padding: 20;" />
         </children>
      </VBox>
   </center>
</BorderPane>