<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="accounting.controller.ContactManagementController">
   <center>
      <TableView fx:id="contactTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="contactIdColumn" prefWidth="75.0" text="المعرف" />
          <TableColumn fx:id="nameColumn" prefWidth="200.0" text="الاسم" />
            <TableColumn fx:id="typeColumn" prefWidth="120.0" text="النوع" />
            <TableColumn fx:id="phoneColumn" prefWidth="150.0" text="الهاتف" />
            <TableColumn fx:id="addressColumn" prefWidth="250.0" text="العنوان" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button onAction="#handleAddContact" styleClass="success" text="إضافة" />
            <Button onAction="#handleEditContact" styleClass="warning" text="تعديل" />
            <Button onAction="#handleDeleteContact" styleClass="danger" text="حذف" />
            <Button onAction="#handleViewStatement" text="كشف حساب" />
         </children>
         <padding>
            <Insets left="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>